# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Prisma / Postgres (required for migrations and db push). This is NOT the same as anon/service keys:
# those keys only talk to Supabase over HTTPS; Prisma needs a real Postgres TCP connection string.
#
# Use the Transaction pooler for Prisma (serverless-safe): Dashboard → Connect → Transaction pooler (port 6543).
# Do NOT use Session mode (:5432 on pooler) with Vercel/serverless — you get MaxClientsInSessionMode when traffic spikes.
# Append: sslmode=require&pgbouncer=true&connection_limit=1 (pgbouncer=true is required for Prisma + transaction pooler).
# Direct host db.YOUR_REF.supabase.co is often IPv6-only; Supabase shows "Not IPv4 compatible". On Windows / many
# home networks you get Prisma P1001 (can't reach server) if DIRECT_DATABASE_URL uses that host.
# Must be postgresql://... NOT https://...  Use the URI Supabase shows (password URL-encoded if it has /, &, etc.).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1
# Prisma CLI (`migrate deploy`, `db push`) uses this URL. On IPv4-only networks you MUST NOT use "Direct connection"
# (db.*.supabase.co). Use Supabase Dashboard → Connect → Method: Session pooler → copy URI (host *.pooler.supabase.com,
# port 5432; user is often postgres.YOUR_PROJECT_REF, not postgres). After saving .env, migrate output should show the
# pooler host — if it still shows db.*, DIRECT_DATABASE_URL was not updated or the wrong .env file is loaded.
# Optional: temporarily duplicate DATABASE_URL here to test (transaction pooler); Session pooler is the usual fix for P1001.
DIRECT_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: homepage "Score & Rank" preview pulls the latest stored advanced rubric for this Founder email (video, deck, or idea).
# If unset, a bundled snapshot is used instead. Update the snapshot in lib/home-demo-rubric.ts after major pipeline changes.
# HOME_DEMO_RUBRIC_EMAIL=founder@example.com

# Optional: Storage bucket (Dashboard → Storage; default name: uploads)
# SUPABASE_STORAGE_BUCKET=uploads

# Public site URL (required in production for email magic links / OTP redirect).
# Must match your Vercel domain, e.g. https://your-app.vercel.app
# In Supabase → Authentication → URL Configuration:
# - Site URL: http://localhost:3000 (dev) or your production URL
# - Redirect URLs (add BOTH when developing locally — required for Google/GitHub OAuth):
#   http://localhost:3000/api/auth/callback
#   https://YOUR_PRODUCTION_DOMAIN/api/auth/callback
# Google Cloud Console → OAuth client → Authorized redirect URIs must include Supabase's callback, e.g.:
#   https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# Optional legacy alias (forwards to API): http://localhost:3000/auth/callback
# If callback URLs are missing, Supabase sends users to Site URL with ?code= on "/" instead.
NEXT_PUBLIC_URL=http://localhost:3000

# Product surface: omit or set to 0/false to focus the app on unified analyze + matches + discover (default).
# Set to 1 or true to restore legacy pages and APIs: /founder/network, resume analysis, standalone deck/video flows, /api/yc-insider/*, etc.
# NEXT_PUBLIC_NEXUS_LEGACY_EXTRAS=1

# Admin dashboard & unlimited credits (comma-separated). Required if you want any admin; no hardcoded default.
# Login uses the normal magic-link email for all addresses listed here.
# Security: never commit real ADMIN_EMAIL or service-role keys; restrict Supabase RLS; API routes require a valid session.
ADMIN_EMAIL=you@example.com

# Comma-separated emails that get unlimited credits (same billing bypass as admin: analyses, smart match, rate-limit skip).
# Does NOT grant /admin routes or isAdmin in /api/auth/check — add those addresses to ADMIN_EMAIL if you want dashboard access.
# UNLIMITED_CREDITS_EMAIL=friend@example.com,other@example.com

# Tester super account: passwordless instant login (no magic link). Disabled unless explicitly enabled.
# Login with TEST_SUPER_ACCOUNT_LOGIN (default test12345) on /login — no password, no email verification.
# Grants approval bypass, premium, and 1M credits. Do NOT enable on public production without understanding the risk.
# ENABLE_TEST_SUPER_ACCOUNT=true
# TEST_SUPER_ACCOUNT_LOGIN=test12345
# TEST_SUPER_ACCOUNT_EMAIL=test12345@nexus.test

# Unified AI analysis (`/api/analyze-unified-pitch`) requires a real Supabase session or the dev bypass below.
# It never impersonates ADMIN_EMAIL without logging in — there is no implicit “first admin user” fallback.
#
# Local dev only: skip Supabase session for AI analysis via POST /api/dev/ai-bypass/bootstrap (sandbox User/Founder).
# Requires `next dev` (NODE_ENV=development). Do not set in production.
# NEXT_PUBLIC_DEV_AI_ANALYSIS_BYPASS=true
# Optional sandbox email (default dev-ai-bypass@localhost.nexus):
# DEV_AI_ANALYSIS_BYPASS_EMAIL=

# Resend (magic-link and transactional email). If unset, login/signup send magic links through Supabase Auth email instead
# (configure SMTP in Supabase Dashboard → Authentication → Emails). Local dev without either: link is only printed in the terminal.
# https://resend.com/api-keys
# RESEND_API_KEY=re_...
#
# Optional: Resend "from" header (default: "NEXUS <onboarding@resend.dev>")
# Must be either bare email@domain.com or exactly: Display Name <email@domain.com> (angle brackets required).
# Wrong: NEXUS notify@domain.com — Resend returns 422. Right: NEXUS <notify@yourdomain.com>
# For production, verify your domain in Resend and set a matching address.
# RESEND_FROM_EMAIL=NEXUS <notify@yourdomain.com>
#
# Comma-separated inboxes that receive an internal email when a *new* founder profile is created (first submit).
# FOUNDER_SIGNUP_NOTIFY_EMAIL=you@example.com

# OPENAI_API_KEY=
# Optional: model for JSON/scoring when using direct OpenAI (no OpenRouter/Ollama). Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# VC semantic matching (orchestrator Step 5): Voyage voyage-3 (1024-dim). Investor.embedding must match pitch vectors.
# Legacy rows with other dimensions (e.g. 3072) are not convertible — run npm run generate-vc-embeddings to re-embed with Voyage.
# VOYAGE_API_KEY=
# After research workers update an investor, refresh that row's embedding immediately (public rows only). Set 0 to rely on the daily embeddings job only.
# VC_SYNC_EMBEDDING_AFTER_RESEARCH=0
# High-RPM orgs: lower delay between embedding requests (ms). Default 21000 (~3 RPM). Example: 50
# VOYAGE_MIN_REQUEST_INTERVAL_MS=50
# Optional: run `faiss-service` (see faiss-service/README) for fast /rank; if the service is down, the app falls back to in-memory cosine on DB embeddings when enough investors have vectors.
# FAISS_SERVICE_URL=http://localhost:8001
#
# Railway / Docker only — faiss-data/*.faiss is gitignored, so the container must fetch binaries:
# FAISS_DATA_ARCHIVE_URL=https://.../faiss-bundle.tar.gz
# Optional bearer if URL requires auth:
# FAISS_DATA_DOWNLOAD_TOKEN=
# Or two direct URLs instead of an archive:
# FAISS_VC_INDEX_URL=https://.../vc_index.faiss
# FAISS_VC_JSON_URL=https://.../vcs_embedding_inputs_trimmed.json
#
# Who is included when building faiss-data (npm run build-faiss-index / rebuild-faiss-index):
# FAISS_INDEX_FILTER=public_discoverable   # default: verified + isPublic + discoverable (+embedding for build)
# FAISS_INDEX_FILTER=pristine             # same prefilter, then lib/investor-pristine-gate.ts (smaller, high-quality set)
# FAISS_INDEX_FILTER=legacy_verified_embedded
# FAISS_INDEX_FILTER=legacy_verified_all
# If port 8001 is already in use (Windows Errno 10048), pick another port for Python and match the URL here:
# FAISS_SERVICE_PORT=8002
# FAISS_SERVICE_URL=http://localhost:8002
# Dev only: after a dimension mismatch, keep hitting FAISS each request (e.g. rebuild index without restarting Next). Not for production.
# FAISS_RETRY_ON_DIMENSION_MISMATCH=1

# --- Full pitch review (unified analysis) / demo checklist ---
# 1) VOYAGE_API_KEY — pitch vectors (voyage-3, 1024-d); must match Investor.embedding and FAISS index.
# 2) FAISS_SERVICE_URL — point Next.js at running faiss-service (see faiss-service/README); primary vector search. If unreachable, orchestrator falls back to in-memory cosine on DB embeddings (needs enough rankable rows).

# 3) OPENROUTER_API_KEY — all LLM calls (scoring, VC extraction, match narratives, analysis).
# 4) GEMINI_API_KEY or GOOGLE_API_KEY — 12 binary gate questions per VC (lib/matching/gate-reasoner.ts); not routed through OpenRouter.
# 5) Exa — single module lib/exa-keys.ts reads env; used app-wide with key rotation on quota.
#    EXA_API_KEYS — recommended: comma- or newline-separated list (all keys can live here only).
#    EXA_API_KEY — optional; if set, merged before EXA_API_KEYS entries (legacy single-key).
#    EXA_API_KEY_1 … EXA_API_KEY_20 — optional extra slots (one key per variable).
# EXA_API_KEYS=key1,key2,key3
# EXA_API_KEY=optional-primary-if-you-use-both
#
# Investor enrichment CLI (`npm run enrich:one`): delay between the 3 dedicated Exa searches (ms). Default 600.
# Use 0 for max speed with dedicated keys; 1500 if discovery/workers share the same keys and you hit quota.
# INVESTOR_ENRICH_EXA_DELAY_MS=600
#
# Investor enrichment: dump merged Exa `rawSources` to a file before LLM (diagnose empty extraction).
# Recommended on Windows: put these in .env.local (PowerShell `set VAR=1` does not pass env to npm/tsx).
# INVESTOR_ENRICH_DUMP_RAW=1
# INVESTOR_ENRICH_DUMP_RAW_PATH=debug-raw-sources.txt
#
# Investor enrichment: log rawSources length + 500-char preview before firm-field LLM (INVESTOR_ENRICH_DEBUG_FIRM=1).
# INVESTOR_ENRICH_DEBUG_FIRM=1
#
# Logged-in sanity check: GET /api/system/analysis-readiness (no secrets returned).

# LLM — OpenRouter for most app features; investor research can use OpenRouter OR local Ollama (OpenAI-compatible API).
# OPENROUTER_API_KEY=
# OPENROUTER_VC_EXTRACTION_MODEL=meta-llama/llama-3.3-70b-instruct
#
# Local Ollama for workers / investor JSON extraction (no OpenRouter key required if Ollama is set):
# OLLAMA_BASE_URL=http://127.0.0.1:11434   # with or without trailing /v1 (code normalizes)
# OLLAMA_MODEL=qwen2.5:14b-instruct          # or llama3.3, mistral, etc. (pull in Ollama first)
# OLLAMA_VC_MODEL=qwen2.5:32b-instruct       # optional: stronger model for extraction only
# VC_LLM_PROVIDER=ollama                       # force Ollama even when OPENROUTER_API_KEY is set; omit = OpenRouter if key else Ollama
# OLLAMA_JSON_OBJECT=1                       # json_object mode (default on); set 0 if your model errors on response_format
# OPENROUTER_JSON_OBJECT=1                     # json_object for OpenRouter VC JSON (default on); set 0 if a model rejects it
# OPENROUTER_429_MAX_ATTEMPTS=4                # total tries per request on 429 (default 4); 1 = no retries
# OPENROUTER_429_BASE_DELAY_MS=2000          # first backoff base in ms (doubles each 429, + jitter; default 2000)
#
# Voyage embeddings after each researched investor (default on). Disable only if you rely on the scheduled job alone:
# VC_SYNC_EMBEDDING_AFTER_RESEARCH=0
#
# Investor research retrieval (Exa → auto-research-vcs): three parallel queries per firm (mandate, deals, accelerator/angel/CVC/grants).
# VC_RESEARCH_EXA_SINCE=YYYY-MM-DD     # fixed recency floor (overrides rolling window below)
# VC_RESEARCH_EXA_RECENCY_DAYS=400     # rolling startPublishedDate; omit or 0 = no date filter (widest corpus)
# VC_RESEARCH_EXA_NUM_RESULTS=8        # per-pass budget scales ~2/3 of this per query (3 queries)
# VC_RESEARCH_EXA_MAX_CHARS=3800       # chars per Exa snippet (default 3800)
# VC_RESEARCH_CONTEXT_CHARS=24000      # max chars passed to the LLM from merged Exa text (default 24000, cap 32000)
# OPENROUTER_SCORING_MODEL=deepseek/deepseek-chat   # optional: multi-pass pitch scoring + tier
# OPENROUTER_ANALYSIS_MODEL=                         # optional: pitch analysis model (benefits from strong reasoning; defaults to scoring model)
# OPENROUTER_MATCHING_MODEL=...  # optional: match narrative model override
# VC_EXTRACTION_MAX_TOKENS=8192   # cap 16000; use 6k–8k+ for large JSON from local models

# Background worker: optional Exa+LLM spot-check during "Data Accuracy Validation" (lib/background-worker.ts)
# Set > 0 to sample N recently-updated public investors and log score vs fresh Exa (uses same LLM as VC extraction).
# WORKER_VALIDATION_EXA_SAMPLE=0
# WORKER_VALIDATION_EXA_DELAY_MS=2500
# VC_VALIDATION_EXA_CONTEXT_CHARS=12000
# WORKER_VALIDATION_FULL_LOCAL_AUDIT=1   # scan every Investor row (deterministic rules); logs summary on each validation job

# Maintenance worker: npm run worker:start (daemon, --loop) vs worker:start:once (--once, exits when idle; or WORKER_NO_RESCHEDULE=1)
# WORKER_NO_RESCHEDULE=1
# Maintenance worker batch tuning (lib/background-worker.ts, npm run worker:start)
# WORKER_VC_RESEARCH_BATCH_SIZE=25
# WORKER_VC_RESEARCH_DELAY_MS=2500          # pause between batches (min 500ms); lower to ~800ms with stagger enabled
# WORKER_VC_RESEARCH_MAX_CONCURRENT=2       # VCs in parallel per batch (max 5); safe to raise to 4-5 with stagger
# WORKER_VC_RESEARCH_STAGGER_MS=400         # delay between each VC's start inside a batch — spreads 3-query Exa
#                                           # bursts so only ~3 queries fire at once (set 0 to disable)
# Tuning example for 3-4× faster throughput without hitting rate limits:
#   WORKER_VC_RESEARCH_MAX_CONCURRENT=5
#   WORKER_VC_RESEARCH_STAGGER_MS=350
#   WORKER_VC_RESEARCH_DELAY_MS=800
# Same delay/concurrency/stagger apply to `npm run research-vcs -- --all` (parseVcResearchBatchTuningFromEnv in scripts/auto-research-vcs.ts).
# Optional: skip apply/contact Exa+LLM during bulk full research (~2 Exa + 1 LLM per firm saved); backfill with npm run worker:apply-contact-urls
# VC_RESEARCH_BATCH_SKIP_APPLY_CONTACT=1
# npm run research-vcs -- --all: page size per wave (oldest updatedAt + id first; re-run continues from stalest rows)
# VC_RESEARCH_ALL_PAGE_SIZE=250
# WORKER_EXA_UNCACHED_TAKE=20
# WORKER_EXA_STALE_TAKE=15
# WORKER_EXA_ENRICH_DELAY_MS=2000
# WORKER_VC_DIRECTORY_SYNC_INTERVAL_MS=21600000   # default 6h; min 1h in code
# WORKER_VC_DIRECTORY_SYNC_MAX_ROWS=120
# WORKER_VC_DIRECTORY_SYNC_LOOKBACK_HOURS=50
# Monthly thesis/profile windows (lib/worker-vc-refresh-state.ts; default ~30d each if unset, min 60000 ms)
# WORKER_THESIS_REFRESH_INTERVAL_MS=2592000000
# WORKER_PROFILE_REFRESH_INTERVAL_MS=2592000000
# WORKER_EMBEDDINGS_INTERVAL_MS=86400000   # Voyage + FAISS full rebuild cadence (default 24h; min 5m). E.g. 3600000 = 1h for fresher FAISS files.

# Full DB quality report (local + optional Exa): npm run vc:audit-all-quality
# Optional: --json reports/investor-quality.json  |  --exa --exa-limit 50 --exa-scope problematic

# npm run workers:all — discover runs forever until Ctrl+C; tune pace below (min 10s between passes)
# WORKERS_DISCOVER_INTERVAL_MS=30000    # default ~30s; try 10000–60000 (~10s–1m). Longer = easier on Exa quotas.
# WORKERS_DISCOVER_DELAY_MS=1000
# WORKERS_DISCOVER_QUERY_DELAY_MS=800
# VC_DISCOVERY_EXA_MAX_CHARS=2400       # snippet depth per discovery hit (default 2400)

# 8) Discovery Growth Worker (3-phase pipeline: discover → validate → research)
#    Uses VCDiscoveryCandidate staging table + systematic sector/region/stage coverage tracking.
#    Run: npx tsx scripts/vc-supabase-ingest-worker.ts --discover
# DISCOVERY_BATCH_SIZE=10               # candidates per research batch in Phase C (default 10)
# DISCOVERY_ROUNDS_PER_PASS=6           # Exa query rounds per discovery pass across all strategies (default 6)
# DISCOVERY_PASS_INTERVAL_MS=3600000    # pause between full 3-phase passes in loop mode (default 1hr)
# DISCOVERY_AUTO_REJECT_NO_WEB=true     # auto-reject candidates without web presence in Phase B (default true)
# DISCOVERY_QUALITY_GATE=true           # run auditInvestorLocal on new entries; hide if errors (default true)

# Founder hub: in development, pending signups are auto-approved on first /api/auth/check so you can
# use /founder/dashboard without the admin queue. Set to 1 to require manual approval locally instead.
# DISABLE_DEV_APPROVAL_BYPASS=1

# Integration logs (FAISS HTTP, Exa bundles, OpenRouter/Ollama JSON): ON by default in NODE_ENV=development.
# INTEGRATION_LOGS=1 enables the same tagged 🔌 INT lines in production. SILENCE_INTEGRATION_LOGS=1 turns them off in dev.
# INTEGRATION_LOGS=1
# SILENCE_INTEGRATION_LOGS=1

# Dev logging: server console is quiet by default. Enable chatty logs when debugging APIs/AI/DB:
# VERBOSE_DEV_LOGS=1
# LOG_LEVEL=debug
# DEBUG=true
# Optional Cursor debug ingest (only if you use the local ingest server):
# CURSOR_DEBUG_INGEST=1
