# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Prisma / Postgres (required for migrations and db push). This is NOT the same as anon/service keys:
# those keys only talk to Supabase over HTTPS; Prisma needs a real Postgres TCP connection string.
#
# Prefer "Session pooler" (IPv4): Dashboard → Connect → Session mode → copy URI (host is aws-0-REGION.pooler.supabase.com).
# IMPORTANT (serverless): add connection_limit=1 to avoid exhausting max clients.
# Direct host db.YOUR_REF.supabase.co is often IPv6-only; on Windows you may see "name resolution failed" or P1001
# unless you use the pooler or fix IPv6/DNS.
# Must be postgresql://... NOT https://...  Use the URI Supabase shows (password already encoded when copied).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=1

# Optional: Storage bucket (Dashboard → Storage; default name: uploads)
# SUPABASE_STORAGE_BUCKET=uploads

# Public site URL (required in production for email magic links / OTP redirect).
# Must match your Vercel domain, e.g. https://your-app.vercel.app
# In Supabase → Authentication → URL Configuration:
# - Site URL: http://localhost:3000 (dev) or your production URL
# - Redirect URLs (add BOTH when developing locally):
#   http://localhost:3000/api/auth/callback
#   https://YOUR_PRODUCTION_DOMAIN/api/auth/callback
# Optional legacy alias (forwards to API): http://localhost:3000/auth/callback
# If callback URLs are missing, Supabase sends users to Site URL with ?code= on "/" instead.
NEXT_PUBLIC_URL=http://localhost:3000

# Admin dashboard & unlimited credits (comma-separated). Required if you want any admin; no hardcoded default.
# Login uses the normal magic-link email for all addresses listed here.
ADMIN_EMAIL=you@example.com

# Optional: Resend "from" header (default: "NEXUS <onboarding@resend.dev>")
# RESEND_FROM_EMAIL=NEXUS <notify@yourdomain.com>

# OPENAI_API_KEY=

# Cloud LLM (OpenRouter) — paid credits; VC_EXTRACTION_MAX_TOKENS lowers default completion cap (default 2048) to avoid 402 when balance is low
# OPENROUTER_API_KEY=
# OPENROUTER_VC_EXTRACTION_MODEL=deepseek/deepseek-chat
# VC_EXTRACTION_MAX_TOKENS=2048   # OpenRouter default in code is 2048; Ollama default is 8192 unless you set this
# VC_OLLAMA_CONTEXT_CHARS=12000   # trim Exa text for local models (smaller = faster, less noise)

# Local LLM (Ollama) — takes priority over OpenRouter when OLLAMA_BASE_URL is set. Install: https://ollama.com  then: ollama pull llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=ollama
# OLLAMA_JSON_STRICT=true   (default) — response_format json_object + low temperature for VC JSON extraction; set false if your Ollama build errors on json_object
