{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/clean-prisma-generate.js --soft-fail-on-lock && cross-env NODE_OPTIONS=--disable-warning=DEP0169 next dev",
    "dev:clean": "node scripts/optimize.js && node scripts/clean-prisma-generate.js --soft-fail-on-lock && cross-env NODE_OPTIONS=--disable-warning=DEP0169 next dev",
    "dev:fresh": "node scripts/optimize.js && node scripts/clean-prisma-generate.js --soft-fail-on-lock && cross-env NODE_OPTIONS=--disable-warning=DEP0169 next dev",
    "build": "node scripts/pre-build.js && cross-env NODE_OPTIONS=--disable-warning=DEP0169 next build",
    "postinstall": "node scripts/clean-prisma-generate.js",
    "start": "cross-env NODE_OPTIONS=--disable-warning=DEP0169 next start",
    "lint": "cross-env NODE_OPTIONS=--disable-warning=DEP0169 next lint",
    "type-check": "tsc --noEmit",
    "test:matching": "tsx lib/matching/__tests__/matching-signals.test-runner.ts",
    "test:auth-policy": "tsx lib/auth/__tests__/ai-analysis-auth-policy.test-runner.ts",
    "perf:budget": "node scripts/check-budgets.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:push": "prisma db push",
    "db:vc-directory": "prisma db execute --file supabase/vc_directory.sql --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/comprehensive-seed.ts",
    "db:seed-human-reviewers": "tsx scripts/seed-human-reviewers.ts",
    "db:seed:original": "tsx prisma/seed.ts",
    "db:reset-test-analyses": "tsx scripts/reset-test-analyses.ts",
    "db:studio": "prisma studio",
    "db:generate": "node scripts/clean-prisma-generate.js",
    "db:prisma-procs": "node scripts/clean-prisma-generate.js --list-node-procs",
    "db:import-vcs-csv": "tsx scripts/import-csv-to-db.ts",
    "db:import-vcs-embeddings-jsonl": "tsx scripts/import-vcs-embeddings-jsonl-to-db.ts",
    "add-vcs": "tsx scripts/extract-and-add-vcs.ts",
    "improve-vc-descriptions": "tsx scripts/improve-vc-descriptions.ts",
    "generate-vc-embeddings": "tsx scripts/generate-vc-embeddings.ts",
    "build-faiss-index": "tsx scripts/build-faiss-index.ts",
    "rebuild-faiss-index": "tsx scripts/rebuild-faiss-index.ts",
    "rebuild-faiss-fast": "tsx scripts/rebuild-faiss-fast.ts",
    "give-credits": "tsx scripts/give-credits.ts",
    "optimize": "node scripts/optimize.js",
    "clean": "node scripts/optimize.js",
    "analyze": "cross-env ANALYZE=true NODE_OPTIONS=--disable-warning=DEP0169 next build",
    "research-vcs": "tsx scripts/auto-research-vcs.ts",
    "worker:apply-contact-urls": "tsx scripts/vc-apply-contact-worker.ts",
    "research-worker": "tsx scripts/vc-research-worker.ts",
    "update-vc-accuracy": "tsx scripts/update-vc-accuracy.ts",
    "db:audit-investors": "tsx scripts/audit-investor-directory.ts",
    "worker:start": "tsx scripts/worker-start.ts --loop",
    "worker:start:once": "tsx scripts/worker-start.ts --once",
    "worker:status": "tsx scripts/worker-status.ts",
    "worker:dev": "tsx scripts/worker-start.ts --no-immediate --loop",
    "worker:background": "node worker.js",
    "worker:vc-supabase": "tsx scripts/vc-supabase-ingest-worker.ts",
    "worker:vc-discover": "tsx scripts/vc-supabase-ingest-worker.ts --discover --interval-ms 1800000",
    "workers:all": "tsx scripts/run-all-workers.ts",
    "vc:review-low-quality": "tsx scripts/review-low-quality-vcs.ts",
    "vc:verify-db-exa": "tsx scripts/verify-vc-db-exa.ts",
    "vc:audit-all-quality": "tsx scripts/audit-all-investors-quality.ts",
    "vc:audit-links": "tsx scripts/audit-vc-links.ts",
    "vc:fix-audited-links": "tsx scripts/fix-audited-vc-link-issues.ts",
    "embeddings:rebuild": "tsx scripts/rebuild-embeddings-auto.ts",
    "faiss:install": "cd faiss-service && python -m pip install -r requirements.txt",
    "faiss:prepare": "npm run build-faiss-index && npm run faiss:build",
    "faiss:start": "cd faiss-service && python faiss_api.py",
    "faiss:build": "cd faiss-service && python build_index.py",
    "check-faiss": "tsx scripts/check-faiss.ts",
    "check-embeddings": "tsx scripts/check-embeddings.ts",
    "vc:fix-headline-names": "tsx scripts/fix-headline-firm-names.ts",
    "faiss:sync-firm-names": "tsx scripts/sync-faiss-jsonl-firm-names.ts",
    "logo:knockout-bg": "node scripts/knockout-nexus-logo-bg.mjs",
    "worker:hide-low-quality": "tsx scripts/vc-hide-low-quality-investors.ts",
    "worker:enforce-pristine": "tsx scripts/enforce-investor-pristine.ts",
    "worker:hide-nondiscoverable-public": "tsx scripts/vc-hide-nondiscoverable-from-public.ts",
    "worker:restore-nondiscoverable-public": "tsx scripts/vc-hide-nondiscoverable-from-public.ts --restore",
    "worker:restore-non-canonical": "tsx scripts/vc-restore-if-not-canonical-dup.ts",
    "worker:export-public-snapshot": "tsx scripts/vc-export-public-investors-snapshot.ts",
    "worker:list-hidden": "tsx scripts/vc-list-hidden-investors.ts",
    "worker:audit-firm-dupes": "tsx scripts/audit-similar-firm-names.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@stripe/stripe-js": "^8.5.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tavily/core": "^0.7.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfkit": "^0.17.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.6.1",
    "exa-js": "^2.7.0",
    "framer-motion": "^11.0.5",
    "jose": "^6.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "next": "^14.2.35",
    "openai": "^4.28.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.50.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.4.2",
    "sonner": "^1.4.0",
    "stripe": "^19.3.1",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.35",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.35",
    "prisma": "5.22.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.7.1",
    "typescript": "^5.3.0"
  }
}
