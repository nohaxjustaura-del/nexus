{
  "name": "foundermatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/pre-build.js && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/comprehensive-seed.ts",
    "db:seed:original": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:import-vcs-csv": "tsx scripts/import-csv-to-db.ts",
    "db:import-vcs-embeddings-jsonl": "tsx scripts/import-vcs-embeddings-jsonl-to-db.ts",
    "add-vcs": "tsx scripts/extract-and-add-vcs.ts",
    "improve-vc-descriptions": "tsx scripts/improve-vc-descriptions.ts",
    "generate-vc-embeddings": "tsx scripts/generate-vc-embeddings.ts",
    "build-faiss-index": "tsx scripts/build-faiss-index.ts",
    "rebuild-faiss-index": "tsx scripts/rebuild-faiss-index.ts",
    "rebuild-faiss-fast": "tsx scripts/rebuild-faiss-fast.ts",
    "give-credits": "tsx scripts/give-credits.ts",
    "optimize": "node scripts/optimize.js",
    "clean": "node scripts/optimize.js",
    "analyze": "ANALYZE=true next build",
    "research-vcs": "tsx scripts/auto-research-vcs.ts",
    "research-worker": "tsx scripts/vc-research-worker.ts",
    "update-vc-accuracy": "tsx scripts/update-vc-accuracy.ts",
    "worker:start": "tsx scripts/worker-start.ts",
    "worker:status": "tsx scripts/worker-status.ts",
    "worker:dev": "tsx scripts/worker-start.ts --no-immediate",
    "worker:background": "node worker.js",
    "embeddings:rebuild": "tsx scripts/rebuild-embeddings-auto.ts",
    "faiss:start": "cd faiss-service && python faiss_api.py",
    "faiss:build": "cd faiss-service && python build_index.py"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.3.4",
